{
	"name": "rust-test-highlight",
	"displayName": "Rust Test Highlight",
	"version": "0.2.0",
	"private": false,
	"description": "Highlight your inline Rust or Typescript (Vitest) tests with a customizable background color so they stand out in your editor.",
	"categories": [
		"Other"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/andrewbrey/rust-test-highlight.git"
	},
	"license": "MIT",
	"publisher": "andrewbrey",
	"main": "./dist/extension.js",
	"scripts": {
		"package": "vsce package",
		"vscode:prepublish": "npm run build",
    "build:watch": "vite build --watch",
    "build:tests": "tsc -p tsconfig.test.json --outDir out",
		"build": "vite build --mode production",
		"dev": "vite build --mode=development",
		"dev:watch": "vite build --mode=development --watch",
    "lint": "biome lint src",
		"tests": "vitest run",
		"tests:watch": "vitest --watch"
	},
	"contributes": {

		"commands": [
			{
				"command": "rust-test-highlight.toggle-highlight",
				"title": "Toggle Test Highlighting",
				"category": "Rust Test Highlight"
			}
		],
		"colors": [
			{
				"id": "rustTestHighlight.backgroundColor",
				"description": "Background decoration color for tests",
				"defaults": {
					"dark": "#1c269255",
					"light": "#27b49655",
					"highContrast": "#cfcfcf55"
				}
			}
		]
	},
	"activationEvents": [
		"onLanguage:rust",
		"onLanguage:typescript",
		"onLanguage:javascript"
	],
	"dependencies": {
	},
	"devDependencies": {
		"@vscode/test-cli": "0.0.12",
		"@vscode/test-electron": "2.5.2",
		"@vitest/ui": "3.2.4",
		"@biomejs/biome": "2.2.7",

		"@types/node": "24.9.1",
		"@types/vscode": "1.86.0",
		"@vscode/vsce": "3.6.2",
		"type-fest": "5.1.0",
		"typescript": "5.9.3",
		"vite": "7.1.11",
		"vitest": "3.2.4"
	},
	"engines": {
		"vscode": "^1.86.0"
	},
	"icon": "./docs/logo_large.png",
	"extensionKind": [
		"ui",
		"workspace"
	],
	"pricing": "Free"
}